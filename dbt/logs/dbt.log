    campaign_id,
    campaign_name,
    channel_id,
    channel,
    impressions,
    clicks,
    conversions,
    spend,
    attributed_revenue,
    roas,
    ctr

from "warehouse"."main_staging"."stg_ad_spend"
    );
  
  
